<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:importantForAutofill="noExcludeDescendants"
  tools:targetApi="o"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:padding="10dip"
  android:orientation="vertical">
  
  <TextView
      android:text="@string/initialize_welcome"
      android:layout_width="fill_parent"
      android:layout_height="wrap_content"
      android:textStyle="bold"/>  

  <TextView
    android:paddingTop="10dip"
    android:text="@string/initialize_text"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"/>
  
  <TextView
    android:paddingTop="10dip"
    android:text="@string/enter_password"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"/>
  
  <LinearLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <EditText
      android:imeOptions="flagNoPersonalizedLearning"
      android:id="@+id/master_password_1"
      android:saveEnabled="false"
      android:accessibilityDataSensitive="yes"
      tools:targetApi="34"
      android:layout_width="0dip"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:maxLines="1"
      android:inputType="textPassword"/>

    <!-- See PasswordToggle -->
    <ImageButton
      android:id="@+id/master_password_1_toggle"
      android:layout_width="48dip"
      android:layout_height="48dip"
      android:background="?android:attr/selectableItemBackgroundBorderless"
      android:tint="?android:attr/textColorSecondary"
      android:src="@drawable/ic_visibility"
      android:contentDescription="@string/show_password"/>
  </LinearLayout>

  <TextView
    android:id="@+id/master_password_hint"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:textSize="13sp"
    android:textColor="?android:attr/textColorSecondary"/>

  <TextView
    android:text="@string/repeat_password"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingTop="10dip"/>
    
  <LinearLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <EditText
      android:imeOptions="flagNoPersonalizedLearning"
      android:id="@+id/master_password_2"
      android:saveEnabled="false"
      android:accessibilityDataSensitive="yes"
      tools:targetApi="34"
      android:layout_width="0dip"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:maxLines="1"
      android:inputType="textPassword"/>

    <!-- See PasswordToggle -->
    <ImageButton
      android:id="@+id/master_password_2_toggle"
      android:layout_width="48dip"
      android:layout_height="48dip"
      android:background="?android:attr/selectableItemBackgroundBorderless"
      android:tint="?android:attr/textColorSecondary"
      android:src="@drawable/ic_visibility"
      android:contentDescription="@string/show_password"/>
  </LinearLayout>

  <Button
    android:id="@+id/ok_button"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:text="@string/continue_s"/>
  
</LinearLayout>
