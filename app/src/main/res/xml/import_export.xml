<?xml version="1.0" encoding="utf-8"?>

<!-- The intents of these preferences are set in ImportExportActivity, since
     an <intent> here would have to hardcode the application id. -->
<PreferenceScreen
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:title="Import / Export">

  <Preference
    android:key="file_export"
    android:title="@string/file_export_title"/>

  <Preference
    android:key="file_import"
    android:title="@string/file_import_title"/>

</PreferenceScreen>
